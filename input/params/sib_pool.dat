15 Total PFTs
5  GDD PFTs
11 Pools
6  Groups
****************************************************************************************************************
                                 Pool Parameter Definitions and Units:
----------------------------------------------------------------------------------------------------------------
LP=Leaf Pool
FR=Fine Root Pool
CR=Coarse Root Pool
WP=Wood/Stem Pool
PP=Product Pool
CDB = Coarse Dead Biomass
METL = Metabolic Litter
STRL = Structural Litter
SLIT = Soil Litter
SLOW = Soil Slow
ARM = Soil Armored


----Autotrophic Respiration/Transfer Parameters-----
GR    = Growth respiration coefficients (0-1)
LP_E = Leaf respiration efficiency (fraction from 0-1)
FR_E = Fine Root respiration efficiency (fraction from 0-1)
CR_E = Coarse Root respiration efficiency (fraction from 0-1)
WP_E = Wood/Stem respiration efficiency (fraction from 0-1)
PP_E = Product respiration efficiency (fraction from 0-1)

CR_AML = Canopy assimilation respiration low multiplier (-)
CR_AMH = Canopy assimilation respiration high multiplier (-)
CR_AMin = Canopy assimilation respiration scalar min (-)
CR_AMax = Canopy assimilation respiration scalar max (-)
CR_FMul = Canopy freeze respiration inhibition multiplier (-)
CR_FRef = Canopy freeze respiration inhibition reference (K)
CR_FMin = Canopy freeze respiration inhibition min (-)
CR_HQ10 = Canopy high temperature respiration exponential Q10 base (-)
CR_HRef = Canopy high temperature respiration exponential ref temperature (K)
CR_HMax = Canopy high temperature respiration exponential max (-)

LT_FQ10  = Q10 base for leaf freeze transfer (-)
LT_FTRef = Ref temp for leaf freeze transfer (K)
LT_FMax  = Max daily leaf freeze transfer (fraction per day)

LT_DCoef = Leaf daylength transfer coefficient (-)
LT_DRef  = Leaf daylength transfer ref (diff from max daylength)
LT_DMax  = Leaf daylength transfer maximum (fraction per day)

LT_WB = Leaf dry transfer exponential base (-)
LT_WR = Leaf dry transfer pawfrw reference (-)
LT_WC = Leaf dry transfer coefficient (-)
LT_WMax = Leaf dry transfer maximum (fraction per day)

RRT_FMUL = Root resp/transfer freeze multiplier (-)
RRT_FRef = Root resp/transfer freeze reference temperature (K)
RRT_FMin = Root resp/transfer freeze inhibition minimum (-)
RRT_HQ10 = Root resp/transfer hot Q10 (-)
RRT_HRef = Root resp/transfer hot reference temperature (K)
RRT_HMax = Root resp/transfer maximum temperature scalar (K)

----Heterotrophic Respiration Parameters-----
SFC_FMul = Surface freeze inhibition multiplier (-)
SFC_FRef = Surface freeze inhibition ref temperature (K)
SFC_FMin = Surface freeze inhibition minimum (-)
SFC_HQ10 = Surface high temp Q10 (-)
SFC_HRef = Surface high temp ref temperature (K)
SFC_HMax = Surface high temp max (-)
SFC_PML = Surface precipitation inhibition clim multiplier (-)
SFC_PMin = Surface precipitation inhibition minimum (-)

SOIL_FMul = Soil freeze inhibition multiplier (-)
SOIL_FRef = Soil freeze inhibition ref temperature (K)
SOIL_FMin = Soil freeze inhibition minimum (-)
SOIL_HQ10 = Soil high temp Q10 base (-)
SOIL_HRef = Soil high temp ref temperature (K)
SOIL_Hmax = Soil high temp maximum (-)
SOIL_MMin = Soil moisture inhibition minimum (-)
SOIL_PAWMin = Soil pawfrac inhibition minimum (-)

-----Pool Turnover Times-----
Pool_TT = Turnover time (yr)

-----Respiration Efficiency and Transfer Fractions------
RESP_EFF = Dead pool respiration efficiency (fraction from 0-1)
           --This is the fraction respired during het resp/transfer
           --The fraction transferred to next cascading pool is:
               TRANS_EFF = 1. - RESP_EFF
TRANS_FRAC = Transfer fractions between pools (-)

----Specialty Transfers-----
GRAZE_TRANS=Transfer fractions for grazing (-)
HARVEST_TRANS=Transfer fractions for harvest (-)

