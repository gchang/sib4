#!/usr/bin/perl
# Written 2016/11/12  John Haynes
# Searches user processes (output of ps -aF) for process(es) matching $search_string

use strict;

my $search_string = "SiB4D";

my $done      = 0;
my $first_run = 1;
while ( $done == 0 ) {
    my @res = `ps -a -A | grep $search_string`;
    chomp @res;
    if ( $#res > -1 ) {
        if ($first_run) {
            print
              "Process $search_string is running; waiting for it to finish\n";
            $first_run = 0;
        }
        sleep 1;
    }
    else {
        $done = 1;
    }
}
print "Done\n";
